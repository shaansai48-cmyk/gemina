//@version=6
indicator("Avanza Deep-Quant 15m Telemetry Engine (v6)", shorttitle="AvanzaQuant15m", overlay=true)

// 1. Core Moving Averages, Multi-Day EMA50, Oscillators & Relative Volume (RVOL)
float ema4    = ta.ema(close, 4)
float ema50   = ta.ema(close, 50)
float vwapVal = ta.vwap(hlc3)
float atr14   = ta.atr(14)
float rsi14   = ta.rsi(close, 14)
float volSma  = ta.sma(volume, 20)
float rvol    = volSma > 0 ? (volume / volSma) : 1.0

// 2. Previous Day Low (pd_low) & Previous Day High (pd_high) - non-repainting completed daily bar
float pd_low  = request.security(syminfo.tickerid, "D", low[1],  lookahead=barmerge.lookahead_on)
float pd_high = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)

// 3. True 5-Day Kaufman Efficiency Ratio (ER in [0.0, 1.0]) on Daily Bars for Trend vs Mean-Reversion Classification
float d_net  = request.security(syminfo.tickerid, "D", math.abs(close[1] - close[6]),                 lookahead=barmerge.lookahead_on)
float d_path = request.security(syminfo.tickerid, "D", math.sum(math.abs(close - close[1]), 5)[1],    lookahead=barmerge.lookahead_on)
float eff_er = d_path > 0 ? math.min(1.0, d_net / d_path) : 0.30

// 4. Opening Range High / Low anchored strictly to regular cash market open (immune to Extended Hours pre-market resets)
bool isRegularOpen = session.isfirstbar_regular or (barstate.isfirst and not session.ispremarket and not session.ispostmarket)
var float or_high = na
var float or_low  = na
if isRegularOpen
    or_high := high
    or_low  := low

// 5. Visual Chart Overlays
plot(ema4,    "EMA 4",   color=color.new(color.aqua, 0),   linewidth=2)
plot(ema50,   "EMA 50",  color=color.new(color.purple, 0), linewidth=2)
plot(vwapVal, "VWAP",    color=color.new(color.orange, 0), linewidth=2)
plot(pd_low,  "PD Low",  color=color.new(color.red, 20),   style=plot.style_stepline)
plot(pd_high, "PD High", color=color.new(color.teal, 20),  style=plot.style_stepline)
plot(or_high, "OR High", color=color.new(color.green, 40), style=plot.style_circles)
plot(or_low,  "OR Low",  color=color.new(color.maroon, 40),style=plot.style_circles)

// 6. Native Webhook JSON Alert Emission on Confirmed 15m Bar Close
if barstate.isconfirmed
    string cleanTicker = str.replace_all(syminfo.ticker, "_", " ")
    string isoTime     = str.format_time(time_close, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC")

    string payload = '{"ticker":"' + cleanTicker + '",' +
                     '"time":"' + isoTime + '",' +
                     '"close":' + str.tostring(close, "#.##") + ',' +
                     '"low":' + str.tostring(low, "#.##") + ',' +
                     '"high":' + str.tostring(high, "#.##") + ',' +
                     '"ema4":' + str.tostring(ema4, "#.##") + ',' +
                     '"ema50":' + str.tostring(ema50, "#.##") + ',' +
                     '"vwap":' + str.tostring(vwapVal, "#.##") + ',' +
                     '"or_high":' + str.tostring(nz(or_high, high), "#.##") + ',' +
                     '"or_low":' + str.tostring(nz(or_low, low), "#.##") + ',' +
                     '"pd_low":' + str.tostring(nz(pd_low, low), "#.##") + ',' +
                     '"pd_high":' + str.tostring(nz(pd_high, high), "#.##") + ',' +
                     '"atr14":' + str.tostring(atr14, "#.##") + ',' +
                     '"rsi14":' + str.tostring(rsi14, "#.##") + ',' +
                     '"rvol":' + str.tostring(rvol, "#.##") + ',' +
                     '"efficiency_ratio":' + str.tostring(eff_er, "#.##") + '}'
    alert(payload, alert.freq_once_per_bar_close)
